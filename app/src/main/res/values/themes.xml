<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Arch_Izmir" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Arch_Izmir" parent="Base.Theme.Arch_Izmir" />

    <!--Input Stil-->
    <style name="App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">#67000000</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="hintTextColor">@color/white</item>
        <item name="android:textColorHint">@color/white</item>
    </style>

    <!--primary button-->
    <style name="App.Button.Primary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/white</item>
        <item name="strokeColor">@color/gold_accent</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="backgroundTint">@color/soluk_altin</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!--Social Button-->
    <style name="App.Button.Social" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/white</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="backgroundTint">#62000000</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="boxBackgroundMode">outline</item>
    </style>
    <!-- Ortak Alt Başlık (Gül Kurusu Serif) Stili -->
    <style name="SubtitleTextStyle">
        <item name="android:textColor">#EAD2AC</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <!--Chip Stili-->
    <style name="CustomChipStyle" parent="Widget.MaterialComponents.Chip.Choice">
        <!-- Seçilmediğindeki Varsayılan Arka Plan ve Yazı Rengi -->
        <item name="chipBackgroundColor">@color/chip_bg_normal</item>
        <item name="android:textColor">@color/chip_text_normal</item>

        <!-- Kenarlık Özellikleri -->
        <item name="chipStrokeColor">@color/chip_stroke_color</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="rippleColor">@color/chip_bg_selected</item>

        <!-- Düzen Ayarları -->
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <style name="ShapeAppearance.RoundedImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
</resources>