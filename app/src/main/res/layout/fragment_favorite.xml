<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.auth.FavoriteFragment"
    android:orientation="vertical"
    android:background="#14111C">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp">
        <!-- Arkadaki Resim -->
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/desen_mavi_sade" />
        <!-- Geçiş -->
        <View
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_header_fade" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="44dp"
            android:paddingEnd="20dp">

            <!--Favori Başlık-->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="@string/favorites"
                android:textColor="#F3E7C9"
                android:textSize="30sp"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="serif"
                android:text="@string/fav_substring"
                android:textColor="@color/krem_bej"
                android:textSize="14sp" />

            <!--Favori Sayısı-->
            <TextView
                android:id="@+id/counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fav_count"
                android:textSize="14sp"
                android:textColor="@color/korfez_grisi"
                android:layout_marginTop="60dp"/>
        </LinearLayout>


    </FrameLayout>


    <!--Yatay Filtre-->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:layout_marginStart="20dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                android:checked="true"
                android:text="@string/all"
                style="@style/CustomChipStyle" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHistory"
                style="@style/CustomChipStyle"
                android:text="@string/history" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipView"
                style="@style/CustomChipStyle"
                android:text="@string/view"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFlavor"
                style="@style/CustomChipStyle"
                android:text="@string/flavor"
                />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSea"
                style="@style/CustomChipStyle"
                android:text="@string/sea" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!--Kaydedilen Kartlar-->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlacesFavorite"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"/>


</LinearLayout>